# MediaTek WMT/STP/PSM core (wmt_drv.ko), MT6765 CONSYS only.
#
# This replaces the stock out-of-tree Kbuild, which picked the platform
# file from MTK_PLATFORM and took headers from drivers/misc/mediatek.
# What the stock build got from the vendor kernel now comes from
# ../adapter.

CONN_DIR := $(src)/..
WMT_DIR := $(src)

ccflags-y += -include $(CONN_DIR)/adapter/mtk_conn_compat.h
ccflags-y += -I$(CONN_DIR)/adapter
ccflags-y += -I$(CONN_DIR)/btif/inc

ccflags-y += -I$(WMT_DIR)/common_detect
ccflags-y += -I$(WMT_DIR)/common_detect/drv_init/inc
ccflags-y += -I$(WMT_DIR)/common_main/include
ccflags-y += -I$(WMT_DIR)/common_main/core/include
ccflags-y += -I$(WMT_DIR)/common_main/linux/include
ccflags-y += -I$(WMT_DIR)/common_main/linux/pri/include
ccflags-y += -I$(WMT_DIR)/common_main/platform/include
ccflags-y += -I$(WMT_DIR)/debug_utility

ccflags-y += -DCONFIG_MTK_WCN_ARM64
ccflags-y += -DWMT_IDC_SUPPORT=0
ccflags-y += -DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT
ccflags-y += -DCONSYS_PMIC_CTRL_6635=1
ccflags-y += -DWMT_PLAT_ALPS=1
ccflags-y += -DWMT_UART_RX_MODE_WORK=0
ccflags-y += -DWMT_SDIO_MODE=1
ccflags-y += -DWMT_CREATE_NODE_DYNAMIC=1
ccflags-y += -DWMT_DBG_SUPPORT=1
ccflags-y += -DWMT_DEVAPC_DBG_SUPPORT=0

ccflags-y += -Wno-missing-prototypes -Wno-missing-declarations
ccflags-y += -Wno-unused-but-set-variable -Wno-unused-variable
ccflags-y += -Wno-unused-function -Wno-enum-conversion
ccflags-y += -Wno-implicit-fallthrough

obj-$(CONFIG_MTK_CONN_WMT) += wmt_drv.o

wmt_drv-y += ../adapter/connectivity_build_in_adapter.o
wmt_drv-y += ../adapter/wmt_build_in_adapter.o

wmt_drv-y += common_detect/wmt_detect_pwr.o
wmt_drv-y += common_detect/wmt_detect.o
wmt_drv-y += common_detect/sdio_detect.o
wmt_drv-y += common_detect/mtk_wcn_stub_alps.o
wmt_drv-y += common_detect/wmt_gpio.o
wmt_drv-y += common_detect/drv_init/fm_drv_init.o
wmt_drv-y += common_detect/drv_init/conn_drv_init.o
wmt_drv-y += common_detect/drv_init/bluetooth_drv_init.o
wmt_drv-y += common_detect/drv_init/wlan_drv_init.o
wmt_drv-y += common_detect/drv_init/common_drv_init.o
wmt_drv-y += common_detect/drv_init/gps_drv_init.o

wmt_drv-y += common_main/platform/mt6765.o
wmt_drv-y += common_main/platform/mt6765_dbg.o
wmt_drv-y += common_main/platform/wmt_plat_alps.o
wmt_drv-y += common_main/platform/mtk_wcn_consys_hw.o
wmt_drv-y += common_main/platform/mtk_wcn_dump_util.o
wmt_drv-y += common_main/platform/mtk_wcn_cmb_hw.o

wmt_drv-y += common_main/core/wmt_ic_6628.o
wmt_drv-y += common_main/core/wmt_conf.o
wmt_drv-y += common_main/core/stp_core.o
wmt_drv-y += common_main/core/wmt_ctrl.o
wmt_drv-y += common_main/core/wmt_func.o
wmt_drv-y += common_main/core/wmt_core.o
wmt_drv-y += common_main/core/psm_core.o
wmt_drv-y += common_main/core/wmt_ic_soc.o
wmt_drv-y += common_main/core/wmt_lib.o
wmt_drv-y += common_main/core/wmt_ic_6620.o
wmt_drv-y += common_main/core/stp_exp.o
wmt_drv-y += common_main/core/wmt_ic_6632.o
wmt_drv-y += common_main/core/wmt_exp.o
wmt_drv-y += common_main/core/btm_core.o
wmt_drv-y += common_main/core/wmt_ic_6630.o

wmt_drv-y += common_main/linux/hif_sdio.o
wmt_drv-y += common_main/linux/stp_dbg_soc.o
wmt_drv-y += common_main/linux/stp_dbg_combo.o
wmt_drv-y += common_main/linux/osal.o
wmt_drv-y += common_main/linux/wmt_dev.o
wmt_drv-y += common_main/linux/wmt_autolaunch.o
wmt_drv-y += common_main/linux/stp_sdio.o
wmt_drv-y += common_main/linux/bgw_desense.o
wmt_drv-y += common_main/linux/wmt_idc.o
wmt_drv-y += common_main/linux/stp_uart.o
wmt_drv-y += common_main/linux/wmt_dbg.o
wmt_drv-y += common_main/linux/stp_dbg.o
wmt_drv-y += common_main/linux/wmt_user_proc.o
wmt_drv-y += common_main/linux/wmt_proc_dbg.o
wmt_drv-y += common_main/linux/wmt_alarm.o
wmt_drv-y += common_main/linux/stp_btif.o

wmt_drv-y += debug_utility/ring.o
wmt_drv-y += debug_utility/ring_emi.o
wmt_drv-y += debug_utility/connsys_debug_utility.o
