# gen4m for the MT6765 CONSYS Wi-Fi: CONNAC 1 ("soc1_0"), AXI WFDMA HIF,
# powered through WMT. This is the stock Makefile reduced to the one
# configuration the stock Rabbit R1 vendor build used:
#   MTK_COMBO_CHIP=CONNAC WLAN_CHIP_ID=6765 CONFIG_MTK_COMBO_WIFI_HIF=axi
#   MTK_ANDROID_WMT=y MTK_ANDROID_EMI=y (user build)
# with the vendor-kernel-only features (EMI MPU API, MDDP, AEE, MET,
# wlan_service test engine, connfem) switched off.

CONN_DIR := $(src)/..
WMT_DIR := $(CONN_DIR)/wmt

ccflags-y += -include $(CONN_DIR)/adapter/mtk_conn_compat.h
ccflags-y += -I$(CONN_DIR)/adapter

# --- chip / HIF selection -------------------------------------------------
ccflags-y += -UMT6620 -UMT6628 -UMT5931 -UMT6630 -UMT6632 -UMT7663
ccflags-y += -USOC2_1X1 -USOC2_2X2 -UUT_TEST_MODE -UMT7915 -USOC3_0
ccflags-y += -UMT7961 -USOC5_0 -USOC7_0
ccflags-y += -DCONNAC
ccflags-y += -D_HIF_AXI=1
ccflags-y += -DLINUX

# --- feature switches, as the stock Makefile sets them for CONNAC/6765 -----
ccflags-y += -DCFG_SUPPORT_DEBUG_FS=0
ccflags-y += -DWLAN_INCLUDE_PROC
ccflags-y += -DCFG_SUPPORT_AGPS_ASSIST=0
ccflags-y += -DCFG_SUPPORT_TSF_USING_BOOTTIME=1
ccflags-y += -DARP_MONITER_ENABLE=1
ccflags-y += -DCFG_ENABLE_HOST_BUS_TIMEOUT=0
ccflags-y += -DCFG_SUPPORT_SET_IPV6_NETWORK=0
ccflags-y += -DCFG_SUPPORT_MDDP_AOR=0
ccflags-y += -DCFG_TRI_TX_RING=0
ccflags-y += -DCFG_ANDORID_CONNINFRA_SUPPORT=0
ccflags-y += -DCFG_SUPPORT_CONNAC2X=0
ccflags-y += -DCFG_SUPPORT_CONNAC2X_2x2=0
ccflags-y += -DCFG_SUPPORT_802_11AX=0
ccflags-y += -DCFG_SUPPORT_802_11BE=0
ccflags-y += -DCFG_SUPPORT_WIFI_6G=0
ccflags-y += -DCFG_SUPPORT_TWT=0
ccflags-y += -DCFG_TWT_SMART_STA=0
ccflags-y += -DCFG_DRIVER_INITIAL_RUNNING_MODE=3
ccflags-y += -DCFG_SUPPORT_DUAL_STA=0
ccflags-y += -DCFG_MTK_ANDROID_WMT=1
ccflags-y += -DCFG_SUPPORT_CONNINFRA=0
ccflags-y += -DCFG_ANDORID_CONNINFRA_COREDUMP_SUPPORT=0
# ERROR | WARN | STATE | EVENT. The vendor default adds INFO, which logs
# every power-own handshake, parsed ARP/ICMP packet and per-second link
# statistics and overwrites the kernel log within minutes.
ccflags-y += -DCFG_DEFAULT_DBG_LEVEL=0x0f
ccflags-y += -DCFG_SUPPORT_PRE_ON_PHY_ACTION=0
ccflags-y += -DWMT_IDC_SUPPORT=0
ccflags-y += -DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT
ccflags-y += -DCFG_SUPPORT_POWER_THROTTLING=0
ccflags-y += -DCFG_TMAC_POWER_LEGACY=1
ccflags-y += -DCFG_TXPOWR_SUPPORT_DBDC=0
ccflags-y += -DCFG_MTK_ANDROID_EMI=1
ccflags-y += -DCFG_WIFI_IP_SET=1
ccflags-y += -DCFG_BUILT_IN_DRIVER=0
ccflags-y += -DCFG_SUPPORT_CHNL_CONFLICT_REVISE=0
ccflags-y += -DCFG_SUPPORT_AEE=0
ccflags-y += -DBUILD_QA_DBG=0
ccflags-y += -DCFG_WPS_DISCONNECT=1
ccflags-y += -DCFG_DOWNLOAD_DYN_MEMORY_MAP=0
ccflags-y += -DCFG_SUPPORT_PASSPOINT=1
ccflags-y += -DCFG_HS20_DEBUG=1
ccflags-y += -DCFG_MET_PACKET_TRACE_SUPPORT=0
ccflags-y += -DCFG_MET_TAG_SUPPORT=0
ccflags-y += -DCFG_TC3_FEATURE=0
ccflags-y += -DCFG_TC10_FEATURE=0
ccflags-y += -DCONFIG_MTK_MD_SUPPORT=0
ccflags-y += -DCFG_TC1_FEATURE=0
ccflags-y += -DCFG_SUPPORT_NAN=0
ccflags-y += -DCFG_MTK_MDDP_SUPPORT=0
ccflags-y += -DCONFIG_WLAN_DRV_BUILD_IN=0
ccflags-y += -DCFG_SUPPORT_PKT_OFLD=0
ccflags-y += -DCONFIG_WLAN_SERVICE=0
ccflags-y += -DCONFIG_TEST_ENGINE_OFFLOAD=0
ccflags-y += -DDBG=0
# needs the vendor PMIC low-battery service (pmic_lbat_service.h)
ccflags-y += -DCFG_MODIFY_TX_POWER_BY_BAT_VOLT=0

# --- include paths ----------------------------------------------------------
ccflags-y += -I$(src)/os -I$(src)/os/linux/include
ccflags-y += -I$(src)/include -I$(src)/include/nic -I$(src)/include/mgmt
ccflags-y += -I$(src)/include/chips
ccflags-y += -I$(src)/os/linux/hif/common/include
ccflags-y += -I$(src)/os/linux/hif/axi/include
ccflags-y += -I$(WMT_DIR)/common_main/include
ccflags-y += -I$(WMT_DIR)/common_main/linux/include
ccflags-y += -I$(srctree)/net

# stock: -Wno-unused-value -Wno-unused-result -Wno-format -Wno-parentheses
ccflags-y += -Wno-unused-value -Wno-unused-result -Wno-format -Wno-parentheses
ccflags-y += -Wno-missing-prototypes -Wno-missing-declarations
ccflags-y += -Wno-unused-but-set-variable -Wno-unused-variable
ccflags-y += -Wno-unused-function -Wno-implicit-fallthrough
ccflags-y += -Wno-enum-conversion

obj-$(CONFIG_MTK_CONN_WLAN_GEN4M) += wlan_drv_gen4m.o

