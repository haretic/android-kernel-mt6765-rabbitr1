#!/bin/sh
# Opt-in unattended recovery: reboot when no USB host has configured the gadget
# for r1.rescue_reboot=SECONDS. Each reboot passes the preloader, where a host
# listener can take over, and gives USB enumeration another chance.
limit= idle=
for arg in $(cat /proc/cmdline); do
    case $arg in
        r1.rescue_reboot=*) limit=${arg#r1.rescue_reboot=} ;;
        # A wedged UDC can keep reporting "configured"; the host proves it can
        # still reach the console by creating /run/host-alive.
        r1.rescue_idle=*) idle=${arg#r1.rescue_idle=} ;;
    esac
done
case $idle in *[!0-9]*) idle= ;; esac
case $limit in ''|*[!0-9]*) exit 0 ;; esac
[ "$limit" -ge 120 ] || limit=120
printf '<6>r1: rescue reboot armed: %ss without a configured USB host\n' "$limit" > /dev/kmsg
# With watchdog.open_timeout set, the kernel stops feeding the watchdog unless
# userspace opens it, so a boot that never reaches this loop resets itself.
wdt=
for dev in /sys/class/watchdog/watchdog*; do
    case $(readlink "$dev/device" 2>/dev/null) in
        *10007000.*) wdt=/dev/${dev##*/} ;;
    esac
done
# The first registered watchdog is mtk-wdt; softdog loads after it.
[ -n "$wdt" ] || { [ -c /dev/watchdog ] && wdt=/dev/watchdog; }
if [ -n "$wdt" ] && exec 3> "$wdt"; then
    printf '<6>r1: rescue feeds %s\n' "$wdt" > /dev/kmsg
else
    wdt=
fi
read -r seen _ < /proc/uptime; seen=${seen%%.*}; host=$seen
while sleep 15; do
    [ -n "$wdt" ] && printf . >&3
    read -r now _ < /proc/uptime; now=${now%%.*}
    for state in /sys/class/udc/*/state; do
        [ "$(cat "$state" 2>/dev/null)" = configured ] && seen=$now
    done
    if [ -e /run/host-alive ]; then rm -f /run/host-alive; host=$now; fi
    if [ -n "$idle" ] && [ $((now - host)) -ge "$idle" ]; then
        printf '<4>r1: rescue reboot: no host console activity for %ss\n' "$((now - host))" > /dev/kmsg
        sync
        /bin/busybox reboot -f
    fi
    if [ $((now - seen)) -ge "$limit" ]; then
        printf '<4>r1: rescue reboot: no configured USB host for %ss\n' "$((now - seen))" > /dev/kmsg
        sync
        /bin/busybox reboot -f
    fi
done
