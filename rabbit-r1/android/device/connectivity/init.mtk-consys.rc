#
# MediaTek MT6765 CONSYS (drivers/staging/mtk-connectivity).
# Each module uses the exports of the ones before it. wmt_drv powers CONSYS
# up, reads the chip id and checks /vendor/firmware/WMT_SOC.cfg at load; the
# ROM patches are downloaded on the first Wi-Fi or Bluetooth power on.
on post-fs
    # Loads alongside the other drivers instead of holding init.
    start vendor.modprobe-consys

# wmt_drv is up: what stock wmt_loader announces. gps_drv.ko loads on
# this (gnss/init.r1.gnss.rc) and mnld checks it.
on property:init.svc.vendor.modprobe-consys=stopped
    setprop vendor.connsys.driver.ready yes

# The Wi-Fi and Bluetooth HALs start with class hal at boot; btmtk_wmt loads last.
on early-boot
    wait /sys/module/btmtk_wmt 5

# btmtk_wmt registers hci0; the core powers it on once (BT patch
# download) and off again until the Bluetooth HAL opens it.
service vendor.modprobe-consys /vendor/bin/modprobe -a -d /vendor/lib/modules mtk_btif_drv wmt_drv wmt_chrdev_wifi wlan_drv_gen4m btmtk_wmt
    disabled
    oneshot
    user root
    group root
    seclabel u:r:vendor_modprobe:s0
