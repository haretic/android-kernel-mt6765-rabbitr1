#
# MediaTek MT6765 CONSYS (drivers/staging/mtk-connectivity).
# Each module uses the exports of the ones before it. wmt_drv powers CONSYS
# up, reads the chip id and checks /vendor/firmware/WMT_SOC.cfg at load; the
# ROM patches are downloaded on the first Wi-Fi or Bluetooth power on.
on post-fs
    insmod /vendor/lib/modules/mtk_btif_drv.ko
    insmod /vendor/lib/modules/wmt_drv.ko
    insmod /vendor/lib/modules/wmt_chrdev_wifi.ko
    insmod /vendor/lib/modules/wlan_drv_gen4m.ko
    # Registers hci0; the core powers it on once (BT patch download) and
    # off again until the Bluetooth HAL opens it.
    insmod /vendor/lib/modules/btmtk_wmt.ko

    # ueventd creates the node asynchronously; post-fs-data writes to it.
    wait /dev/wmtWifi 5

    # wmt_drv is up: what stock wmt_loader announces. gps_drv.ko loads on
    # this (gnss/init.r1.gnss.rc) and mnld checks it.
    setprop vendor.connsys.driver.ready yes
