# drmfb drives the panel backlight that belongs to its DSI connector.
allow hal_graphics_composer_default vendor_sysfs_backlight:dir r_dir_perms;
allow hal_graphics_composer_default vendor_sysfs_backlight:lnk_file read;
allow hal_graphics_composer_default vendor_sysfs_backlight:file rw_file_perms;
# drmfb sizes its hotplug uevent socket's receive buffer, and matches the
# PowerVR device by its uevent while looking for the KMS card.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket setopt;
r_dir_file(hal_graphics_composer_default, sysfs_gpu)
# The lowest backlight level the panel still shows (device.mk).
vendor_internal_prop(vendor_drmfb_prop)
get_prop(hal_graphics_composer_default, vendor_drmfb_prop)
set_prop(vendor_init, vendor_drmfb_prop)
