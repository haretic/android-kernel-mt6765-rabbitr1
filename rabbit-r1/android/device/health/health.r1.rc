# SPDX-License-Identifier: Apache-2.0
# Experimental normal boot; requires genuine kernel CAPACITY first.
on post-fs-data
    start vendor.health-default

# HealthLoop serves Binder only once bpf.progs_loaded=1, which load-bpf-programs
# sets after post-fs-data; blocking post-fs-data on the check would deadlock.
# The check runs alongside boot: the service registers only once primed from
# a real capacity and system_server waits for it (waitForDeclaredService), so
# holding init here only delayed SurfaceFlinger and the HALs (~4 s). Failure
# still shuts down through reboot_on_failure.
on zygote-start
    start r1-health-initial-ready

service vendor.health-default /vendor/bin/hw/android.hardware.health-service.r1
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w

service r1-health-initial-ready /vendor/bin/r1-health-initial-ready
    disabled
    oneshot
    user system
    group system
    file /dev/kmsg w
    timeout_period 40
    reboot_on_failure shutdown,battery-init-failed

service vendor.charger /vendor/bin/hw/android.hardware.health-service.r1 --charger
    class charger
    seclabel u:r:charger_vendor:s0
    user system
    group system wakelock input
    capabilities SYS_BOOT
    file /dev/kmsg w
    file /sys/fs/pstore/console-ramoops-0 r
    file /sys/fs/pstore/console-ramoops r
    file /proc/last_kmsg r
