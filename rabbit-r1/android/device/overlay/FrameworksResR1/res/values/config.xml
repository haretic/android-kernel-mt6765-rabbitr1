<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2% above the lowest level the panel still shows (ro.vendor.drmfb.backlight_min),
         the lowest the user found comfortable. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.02</item>

    <!-- The r1 has no Back or Home keys (only the side button and the scroll wheel).
         Without a navigation bar SystemUI also never attaches the back gesture. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- The panel offers 60 to 100 Hz (panel-rabbit-r1). A non-zero default rate caps
         rendering below the user's peak (60 made 85 Hz render at 42.5 Hz); 0 lets the
         peak rate act as the default. 100 Hz is the panel's preferred mode, so boot
         needs no mode switch. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">100</integer>
    <!-- The motor runs from VIBR, whose steps between the vibrator's 2.0 and
         3.0 V limits are 2.0, 2.8 and 3.0 V; amplitude maps linearly onto that
         range and regulator-haptic picks the nearest step. These factors put
         low, medium (the default) and high on one step each. -->
    <string-array name="config_vibrationIntensityScaleFactors" translatable="false">
        <item>0.2</item>
        <item>0.75</item>
        <item>1.0</item>
    </string-array>
</resources>
