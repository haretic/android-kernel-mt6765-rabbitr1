<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2% above the lowest level the panel still shows (ro.vendor.drmfb.backlight_min),
         the lowest the user found comfortable. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.02</item>

    <!-- The r1 has no Back or Home keys (only the side button and the scroll wheel).
         Without a navigation bar SystemUI also never attaches the back gesture. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- The panel runs at 85 Hz (panel-rabbit-r1); the 60 Hz default made the
         framework render at 85 / 2 = 42.5 Hz. -->
    <integer name="config_defaultRefreshRate">85</integer>
    <integer name="config_defaultPeakRefreshRate">85</integer>
</resources>
