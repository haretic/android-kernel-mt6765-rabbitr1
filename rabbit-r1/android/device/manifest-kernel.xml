<!--
    The kernel's FCM level. Without it VINTF takes the device's (7, from the
    shipping API level), whose matrix only lists kernels 4.14 to 5.15. Linux
    7.1 is listed at 202604 by android/patches/0012 (its requirements: none,
    as for 6.18) and 0009 (the matrices). VINTF matches kernels by
    major.minor.
-->
<manifest version="1.0" type="device">
    <kernel target-level="202604" />
</manifest>
