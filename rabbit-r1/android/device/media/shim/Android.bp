// SPDX-License-Identifier: Apache-2.0
// Android 12 symbols for the stock MediaTek Codec2 libraries (r1_codec2_shim.cpp).

cc_library_shared {
    name: "libr1_codec2_shim",
    vendor: true,
    // The codec libraries it serves are 32-bit only.
    compile_multilib: "32",
    srcs: ["r1_codec2_shim.cpp"],
    // IGraphicBufferProducer as the vendor libstagefright_bufferqueue_helper
    // sees it: built from libgui_bufferqueue_static without binder.
    cflags: [
        "-DNO_BINDER",
        "-Wall",
        "-Werror",
    ],
    static_libs: ["libgui_bufferqueue_static"],
    shared_libs: [
        "android.hardware.graphics.bufferqueue@2.0",
        "libbase",
        "libhidlbase",
        "libstagefright_bufferqueue_helper",
        "libui",
        "libutils",
    ],
}
