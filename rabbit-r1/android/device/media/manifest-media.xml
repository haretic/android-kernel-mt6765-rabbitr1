<!--
    The stock MediaTek Codec2 HAL, as the stock vendor manifest declared it.
    compatibility_matrix.7.xml in Android 17 accepts HIDL IComponentStore
    1.0-2 as default[0-9]*, and with ro.vendor.api_level below 202404 the
    framework uses the HIDL Codec2 services (media.c2.hal.selection=hidl),
    next to the HIDL IComponentStore/software of the swcodec APEX.
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IComponentStore/default</fqname>
    </hal>
</manifest>
