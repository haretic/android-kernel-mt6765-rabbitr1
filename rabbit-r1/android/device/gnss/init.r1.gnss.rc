# SPDX-License-Identifier: Apache-2.0
# MT6765 CONSYS GPS: gps_drv.ko (/dev/stpgps) and the stock MediaTek GNSS
# userspace. Service names, users, groups and sockets are the stock ones
# (init.gps_drv.rc, init.connectivity.common.rc,
# android.hardware.gnss-service.mediatek.rc).

# init.mtk-consys.rc sets this once wmt_drv is loaded, as wmt_loader does
# on stock; gps_drv uses its exports.
on property:vendor.connsys.driver.ready=yes
    # mnld opens /dev/stpgps when a fix is requested, not at start, so
    # nothing waits for ueventd to create it, or for the module.
    start vendor.modprobe-gps

service vendor.modprobe-gps /vendor/bin/modprobe -a -d /vendor/lib/modules gps_drv
    disabled
    oneshot
    user root
    group root
    seclabel u:r:vendor_modprobe:s0

on post-fs-data
    mkdir /data/vendor/gps 0770 gps system
    mkdir /data/vendor/log 0770 gps system
    mkdir /data/vendor/log/gps 0770 gps system

service mnld /vendor/bin/mnld
    class main
    user gps
    capabilities WAKE_ALARM
    group gps inet misc sdcard_rw sdcard_r media_rw system radio wakelock
    socket mnld stream 660 gps system

service vendor.gnss-default /vendor/bin/hw/android.hardware.gnss-service.mediatek
    class hal
    user system
    capabilities WAKE_ALARM
    group system gps
