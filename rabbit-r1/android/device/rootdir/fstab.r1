# SPDX-License-Identifier: Apache-2.0
# Stock uses md_udc for /metadata and para for /misc. Preserve those mappings.
# LK does not publish vbmeta/parts in the DT; name the vbmeta partition here for first-stage AVB.
system      /system     erofs ro  wait,logical,first_stage_mount,slotselect,avb=vbmeta
system_ext  /system_ext erofs ro  wait,logical,first_stage_mount,slotselect,avb
product     /product    erofs ro  wait,logical,first_stage_mount,slotselect,avb
vendor      /vendor     erofs ro  wait,logical,first_stage_mount,slotselect,avb
/dev/block/by-name/md_udc   /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
# No metadata encryption: it needs dm-default-key, which mainline does not have. FBE uses plain fscrypt.
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,errors=panic latemount,wait,check,quota,reservedsize=128M,formattable,fileencryption=aes-256-xts:aes-256-cts:v2
/dev/block/by-name/para /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect

# NV filesystems, mounted read-write by "mount_all /vendor/etc/fstab.r1 --early".
# Stock (etc/fstab.mt6765) marks them formattable. Here they never are: they
# hold this unit's IMEI and RF calibration, and a format loses them for good.
# nofail: a broken NV filesystem must not stop the boot; r1-modem-nvcheck.sh
# then keeps the modem userspace off.
/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,nofail
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,nofail
/dev/block/by-name/nvdata   /mnt/vendor/nvdata    ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,nofail
/dev/block/by-name/nvcfg    /mnt/vendor/nvcfg     ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,nofail
# Raw NV partitions. Not mounted; libnvram.so and libsysenv.so look them up in
# the default fstab (GetEntryForMountPoint) to find the block devices.
/dev/block/by-name/nvram   /nvram   emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults
# Compressed swap in RAM (lz4); enabled by swapon_all once boot completes.
/dev/block/zram0 none swap defaults zramsize=50%
