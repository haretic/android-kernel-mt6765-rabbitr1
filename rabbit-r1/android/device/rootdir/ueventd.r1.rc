# Coldboot relabels all of /sys (55k files at ~0.6 ms each here), which took
# ~32 s on one thread and held up every node apexd and init waited for. Spread
# it over the cores; listing a directory queues each of its subdirectories.
parallel_restorecon enabled
parallel_restorecon_dir /sys
parallel_restorecon_dir /sys/devices
parallel_restorecon_dir /sys/devices/platform
parallel_restorecon_dir /sys/devices/platform/soc

# PowerVR sync device: opened by every EGL/Vulkan client.
/dev/pvr_sync             0666   system     graphics

# CONSYS Wi-Fi power switch (wmt_chrdev_wifi): written by the Wi-Fi HAL.
/dev/wmtWifi              0660   wifi       wifi

# Modem device nodes (modem/ueventd.r1-modem.rc).
import /vendor/etc/ueventd.r1-modem.rc

# GPS device node (gnss/ueventd.r1-gnss.rc).
import /vendor/etc/ueventd.r1-gnss.rc

# Video codec node (media/ueventd.r1-media.rc).
import /vendor/etc/ueventd.r1-media.rc

# Factory reset protection data (ro.frp.pst), read and written by
# system_server's PersistentDataBlockService. Stock ueventd.rc.
/dev/block/by-name/frp    0660   root       system
