# PowerVR sync device: opened by every EGL/Vulkan client.
/dev/pvr_sync             0666   system     graphics

# CONSYS Wi-Fi power switch (wmt_chrdev_wifi): written by the Wi-Fi HAL.
/dev/wmtWifi              0660   wifi       wifi

# Modem device nodes (modem/ueventd.r1-modem.rc).
import /vendor/etc/ueventd.r1-modem.rc

# Factory reset protection data (ro.frp.pst), read and written by
# system_server's PersistentDataBlockService. Stock ueventd.rc.
/dev/block/by-name/frp    0660   root       system
