# SPDX-License-Identifier: Apache-2.0
on fs
    mount_all /vendor/etc/fstab.r1 --early

on late-fs
    mount_all /vendor/etc/fstab.r1 --late

# configfs gadget HAL and init.usb.configfs.rc bind this UDC (mainline musb).
on early-boot
    setprop sys.usb.controller musb-hdrc.0

# Boot deadman: the kernel arms the hardware watchdog (BoardConfig.mk) and resets
# the r1 unless watchdogd takes it over once boot completes. A boot that hangs,
# even with adb up, resets instead of sitting on the boot animation.
service watchdogd /system/bin/watchdogd 10 20
    user root
    oneshot
    disabled
    seclabel u:r:watchdogd:s0

on property:sys.boot_completed=1
    start watchdogd
    swapon_all /vendor/etc/fstab.r1

# Off-mode charging never completes boot.
on charger
    start watchdogd

# PowerVR GE8320 (ported DDK 1.13). rgx.fw comes from /vendor/firmware on first use.
# ueventd sets /dev/pvr_sync's owner and mode (ueventd.r1.rc). Its node can
# appear seconds after the probe, so waiting here only delayed boot.
on post-fs
    # Loads alongside the other drivers instead of holding init.
    start vendor.modprobe-pvr

# gralloc and the composer start with class hal at boot.
on early-boot
    wait /sys/module/pvrsrvkm 5

service vendor.modprobe-pvr /vendor/bin/modprobe -a -d /vendor/lib/modules pvrsrvkm
    disabled
    oneshot
    user root
    group root
    seclabel u:r:vendor_modprobe:s0

# drmfb (system) dims and blanks the panel through the MT6370 backlight.
on boot
    chown system system /sys/class/backlight/mt6370-backlight/brightness
    chown system system /sys/class/backlight/mt6370-backlight/bl_power

# The Lineage health HAL (system) sets the charging policy's level limit.
# The charge current cap belongs to r1-charging (android/charging).
on boot
    chown system system /sys/devices/platform/charging-policy/charge_start_level
    chown system system /sys/devices/platform/charging-policy/charge_stop_level
