# SPDX-License-Identifier: Apache-2.0
# LK passes maxcpus=1. Secondary cores come up fine over PSCI; online them
# here, after the hardware watchdog is armed, rather than in early boot.
on early-init
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
    write /sys/devices/system/cpu/cpu4/online 1
    write /sys/devices/system/cpu/cpu5/online 1
    write /sys/devices/system/cpu/cpu6/online 1
    write /sys/devices/system/cpu/cpu7/online 1

on fs
    mount_all /vendor/etc/fstab.r1 --early

on late-fs
    mount_all /vendor/etc/fstab.r1 --late

# configfs gadget HAL and init.usb.configfs.rc bind this UDC (mainline musb).
on early-boot
    setprop sys.usb.controller musb-hdrc.0

# Boot deadman: with watchdog.open_timeout on the kernel cmdline the hardware
# watchdog resets the r1 unless Android completes boot or brings up adb first.
service watchdogd /system/bin/watchdogd 10 20
    user root
    oneshot
    disabled
    seclabel u:r:watchdogd:s0

on property:sys.boot_completed=1
    start watchdogd
    # The logcat mirror is for boot debugging; it costs most of a core afterwards.
    stop vendor.r1-logcat-kmsg

# With the gadget HAL (sys.usb.configfs=2) init never sets sys.usb.state.
on property:init.svc.adbd=running
    start watchdogd

service vendor.r1-logcat-kmsg /vendor/bin/r1-logcat-kmsg.sh
    user root
    group log
    disabled
    seclabel u:r:shell:s0

on post-fs-data
    start vendor.r1-logcat-kmsg

# Bring-up builds: allow adb root without the developer-options toggle.
on post-fs-data && property:ro.debuggable=1
    write /data/adbroot/enabled 1

# PowerVR GE8320 (ported DDK 1.13). rgx.fw comes from /vendor/firmware on first use.
on post-fs
    insmod /vendor/lib/modules/pvrsrvkm.ko
    wait /dev/pvr_sync 5
    chown system graphics /dev/pvr_sync
    chmod 0666 /dev/pvr_sync

# drmfb (system) dims and blanks the panel through the MT6370 backlight.
on boot
    chown system system /sys/class/backlight/mt6370-backlight/brightness
    chown system system /sys/class/backlight/mt6370-backlight/bl_power
