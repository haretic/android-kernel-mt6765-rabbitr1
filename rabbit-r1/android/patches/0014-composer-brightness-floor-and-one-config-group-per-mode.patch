From: itskenny0 <0@kenny.cat>
Subject: [PATCH] drmfb: map brightness 0 to the lowest visible backlight level; switch refresh rates safely

Composer brightness 0 is the minimum level and -1 is off, but 0 was
written as backlight 0, which turns many panels off: dimming before
screen-off then blanks the display. Map [0, 1] onto [min, max], where
min defaults to 1 and ro.vendor.drmfb.backlight_min can raise it.

A config group promises seamless switching, but applying a mode
power-cycles the display. With every same-size mode in one group,
SurfaceFlinger could switch rates on its own to follow content and
blank the panel each time. Give each config its own group.

A mode switch dropped the cached client target slots. SurfaceFlinger
keeps sending cached targets by slot alone, so the display had no
frame to present and stayed off. Keep the slots when the size is
unchanged.
---
  .../graphics/composer/drmfb/ComposerClient.cpp     | 12 +++++++++--
  interfaces/graphics/composer/drmfb/DrmDevice.cpp   | 24 ++++++++++++++++------
  interfaces/graphics/composer/drmfb/DrmDevice.h     |  1 +
  3 files changed, 29 insertions(+), 8 deletions(-)

diff --git a/interfaces/graphics/composer/drmfb/ComposerClient.cpp b/interfaces/graphics/composer/drmfb/ComposerClient.cpp
index e65a692..ad297e1 100644
--- a/interfaces/graphics/composer/drmfb/ComposerClient.cpp
+++ b/interfaces/graphics/composer/drmfb/ComposerClient.cpp
@@ -806,10 +806,18 @@ int32_t ComposerClient::SetActiveConfigLocked(int64_t display, int32_t config,
     drmfb::DrmDisplay* drm_display = FindDisplayLocked(display);
     DisplayState* state = FindStateLocked(display);
     if (drm_display == nullptr || state == nullptr) return kBadDisplay;
-    if (FindConfig(*drm_display, config) == nullptr) return kBadConfig;
+    const drmfb::DrmConfig* requested = FindConfig(*drm_display, config);
+    if (requested == nullptr) return kBadConfig;
     if (drm_display->active_config == config) return 0;
+    const drmfb::DrmConfig* current = FindConfig(*drm_display, drm_display->active_config);
+    const bool same_size = current != nullptr &&
+                           current->mode.hdisplay == requested->mode.hdisplay &&
+                           current->mode.vdisplay == requested->mode.vdisplay;
     if (!drm_.SetActiveConfig(display, config)) return IComposerClient::EX_CONFIG_FAILED;
-    state->target_slots.assign(state->target_slots.size(), nullptr);
+    // SurfaceFlinger keeps sending cached client targets by slot alone. Buffers of the
+    // old size still fit a rate-only switch; dropping them left the display with no
+    // frame to present, so the deferred power-on never happened.
+    if (!same_size) state->target_slots.assign(state->target_slots.size(), nullptr);
     state->target.reset();
     state->target_full_damage = true;
     state->target_damage.clear();
diff --git a/interfaces/graphics/composer/drmfb/DrmDevice.cpp b/interfaces/graphics/composer/drmfb/DrmDevice.cpp
index 476e4cb..b6f091c 100644
--- a/interfaces/graphics/composer/drmfb/DrmDevice.cpp
+++ b/interfaces/graphics/composer/drmfb/DrmDevice.cpp
@@ -495,6 +495,7 @@ std::vector<DrmDevice::HotplugChange> DrmDevice::Rescan() {
         if (old != displays_.end()) {
             candidate.backlight_path = old->second.backlight_path;
             candidate.backlight_max = old->second.backlight_max;
+            candidate.backlight_min = old->second.backlight_min;
             candidate.backlight_power_down = old->second.backlight_power_down;
         }
         if (old != displays_.end() && was_connected) {
@@ -573,8 +574,10 @@ bool DrmDevice::DiscoverConnector(uint32_t connector_id, DrmDisplay* display) {
             auto [it, inserted] = stable_config_ids_.emplace(key, next_config_id_);
             if (inserted) ++next_config_id_;
             config.id = it->second;
-            config.group =
-                    (static_cast<int32_t>(config.mode.hdisplay) << 16) | config.mode.vdisplay;
+            // A config group promises seamless switching. Applying a mode power-cycles the
+            // display, so every config is its own group and SurfaceFlinger never switches
+            // modes on its own to follow content.
+            config.group = config.id;
             display->configs.push_back(config);
             if (i == 0 || (config.mode.type & DRM_MODE_TYPE_PREFERRED) != 0) {
                 display->active_config = config.id;
@@ -753,10 +756,15 @@ void DrmDevice::DiscoverBacklight() {
         !android::base::ParseUint(android::base::Trim(maximum), &max_value) || max_value == 0) {
         return;
     }
+    // Brightness 0 is the dimmest visible level, not off. Panels that go dark below a
+    // higher level than 1 set it in ro.vendor.drmfb.backlight_min.
+    const uint32_t min_value = android::base::GetUintProperty<uint32_t>(
+            "ro.vendor.drmfb.backlight_min", 1, max_value);
     internal_displays[0]->backlight_path = backlights[0];
     internal_displays[0]->backlight_max = max_value;
-    ALOGI("Display %" PRId64 " uses backlight %s max=%u", internal_displays[0]->id,
-          backlights[0].c_str(), max_value);
+    internal_displays[0]->backlight_min = min_value;
+    ALOGI("Display %" PRId64 " uses backlight %s min=%u max=%u", internal_displays[0]->id,
+          backlights[0].c_str(), min_value, max_value);
 }
 
 bool DrmDevice::PlaneSupportsFormat(const DrmDisplay& display, uint32_t format,
@@ -1449,9 +1457,13 @@ bool DrmDevice::SetBrightness(int64_t display, float brightness) {
     auto it = displays_.find(display);
     if (it == displays_.end() || !HasBrightness(display)) return false;
     DrmDisplay& drm_display = it->second;
-    const float normalized = brightness < 0.0F ? 0.0F : brightness;
+    // Composer brightness 0 is the minimum level; only -1 (power down below) is off.
+    const float normalized = std::clamp(brightness, 0.0F, 1.0F);
+    const uint32_t range = drm_display.backlight_max - drm_display.backlight_min;
     const uint32_t value =
-            static_cast<uint32_t>(std::lround(normalized * drm_display.backlight_max));
+            brightness < 0.0F ? 0
+                              : drm_display.backlight_min +
+                                        static_cast<uint32_t>(std::lround(normalized * range));
     if (!android::base::WriteStringToFile(std::to_string(value),
                                           drm_display.backlight_path + "/brightness")) {
         ALOGE("Failed to set display %" PRId64 " backlight to %u: %s", display, value,
