From: itskenny0 <0@kenny.cat>
Subject: [PATCH] lineage-sdk: allow a charging limit down to 50%

Devices that live on a charger benefit from holding the battery well
below 70%. Accept limits from 50% so the setting can store them.
---
 sdk/src/java/lineageos/providers/LineageSettings.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/sdk/src/java/lineageos/providers/LineageSettings.java b/sdk/src/java/lineageos/providers/LineageSettings.java
index f52b422..156b3cc 100644
--- a/sdk/src/java/lineageos/providers/LineageSettings.java
+++ b/sdk/src/java/lineageos/providers/LineageSettings.java
@@ -1403,8 +1403,9 @@ public final class LineageSettings {
         public static final String CHARGING_CONTROL_LIMIT = "charging_control_charging_limit";
 
         /** @hide */
+        // Down to 50%, for devices kept on a charger.
         public static final Validator CHARGING_CONTROL_LIMIT_VALIDATOR =
-                new InclusiveIntegerRangeValidator(70, 100);
+                new InclusiveIntegerRangeValidator(50, 100);
 
         /**
          * Fast charging mode
