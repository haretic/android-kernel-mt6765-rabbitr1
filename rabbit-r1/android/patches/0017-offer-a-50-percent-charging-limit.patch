From: itskenny0 <0@kenny.cat>
Subject: [PATCH] LineageParts: offer charging limits from 50%

Start the charging limit slider at 50%, the lowest limit the
settings validator now accepts.
---
 src/org/lineageos/lineageparts/health/ChargingLimitPreference.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/org/lineageos/lineageparts/health/ChargingLimitPreference.java b/src/org/lineageos/lineageparts/health/ChargingLimitPreference.java
index 4bcc545..e65413c 100644
--- a/src/org/lineageos/lineageparts/health/ChargingLimitPreference.java
+++ b/src/org/lineageos/lineageparts/health/ChargingLimitPreference.java
@@ -49,7 +49,8 @@ public class ChargingLimitPreference extends SliderPreference
         mSlider.setLabelBehavior(LabelFormatter.LABEL_FLOATING);
         mSlider.setStepSize(1);
         mSlider.setTickVisible(false);
-        mSlider.setValueFrom(70);
+        // Matches LineageSettings.System.CHARGING_CONTROL_LIMIT_VALIDATOR.
+        mSlider.setValueFrom(50);
         mSlider.setValueTo(100);
 
         int currLimit = getSetting();
